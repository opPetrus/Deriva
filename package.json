    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
